PORT=9108
# Required in production (GIN_MODE=release). Use a long random string (>= 16 chars).
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Database connection. Leave commented to configure via the web installer (/install)
# on first run; the installer writes the values back to this .env file.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=hmimg
# DB_PASSWORD=hmimg_password
# DB_NAME=hmimg_db

UPLOAD_DIR=uploads

# Set true only when behind a trusted reverse proxy that sets X-Forwarded-* headers
TRUST_PROXY=false

