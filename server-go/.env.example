PORT=9108
# Required in production (GIN_MODE=release). Use a long random string (>= 16 chars).
JWT_SECRET=YOUR_JWT_SECRET_HERE

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hmimg_db
DB_PASSWORD=hmimg_password
DB_NAME=hmimg_db

UPLOAD_DIR=uploads

# Set true only when behind a trusted reverse proxy that sets X-Forwarded-* headers
TRUST_PROXY=false

